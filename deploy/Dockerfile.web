FROM node:24-alpine AS base
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY lib/api-spec/package.json ./lib/api-spec/
COPY lib/api-client-react/package.json ./lib/api-client-react/
COPY lib/object-storage-web/package.json ./lib/object-storage-web/ 2>/dev/null || true
COPY artifacts/school-saas/package.json ./artifacts/school-saas/
RUN pnpm install --frozen-lockfile --ignore-scripts

FROM deps AS builder
COPY lib/ ./lib/
COPY artifacts/school-saas/ ./artifacts/school-saas/
COPY tsconfig.base.json tsconfig.json ./
RUN pnpm --filter @workspace/api-client-react run build 2>/dev/null || true
RUN PORT=80 BASE_PATH=/ NODE_ENV=production pnpm --filter @workspace/school-saas run build

FROM nginx:alpine AS runner
COPY --from=builder /app/artifacts/school-saas/dist/public /usr/share/nginx/html
COPY deploy/nginx-static.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
