FROM node:24-alpine AS base
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app

# ── Stage 1: Install all dependencies ───────────────────────────────────────
FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY lib/db/package.json             lib/db/
COPY lib/api-spec/package.json       lib/api-spec/
COPY lib/api-zod/package.json        lib/api-zod/
COPY lib/api-client-react/package.json lib/api-client-react/
COPY lib/object-storage-web/package.json lib/object-storage-web/
COPY artifacts/school-saas/package.json artifacts/school-saas/
RUN pnpm install --frozen-lockfile --ignore-scripts

# ── Stage 2: Vite production build ──────────────────────────────────────────
FROM deps AS builder
COPY tsconfig.base.json tsconfig.json ./
COPY lib/ lib/
COPY artifacts/school-saas/ artifacts/school-saas/
RUN PORT=80 BASE_PATH=/ NODE_ENV=production \
    pnpm --filter @workspace/school-saas run build

# ── Stage 3: Serve static files via Nginx ───────────────────────────────────
FROM nginx:alpine AS runner
COPY --from=builder /app/artifacts/school-saas/dist/public /usr/share/nginx/html
COPY deploy/nginx-static.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
