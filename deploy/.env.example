# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Strong random password — generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# ── Session ───────────────────────────────────────────────────────────────────
# Long random secret — generate with: openssl rand -base64 64
SESSION_SECRET=CHANGE_ME_very_long_random_session_secret

# ── MinIO (file/photo storage) ───────────────────────────────────────────────
MINIO_ROOT_USER=tsos_admin
# Generate with: openssl rand -base64 32
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password

# ── Paystack payments ─────────────────────────────────────────────────────────
# Get these from dashboard.paystack.com → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ── Email (SMTP) — leave blank to disable email sending ──────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Africa's Talking (SMS) — leave blank to disable SMS ──────────────────────
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
