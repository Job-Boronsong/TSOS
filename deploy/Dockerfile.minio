# Custom MinIO image based on Alpine (musl libc) instead of the official image
# which uses glibc and requires x86-64-v2 CPU instructions.
# The MinIO binary is pure Go (no CGo) and runs fine on Alpine/musl.
FROM alpine:3.19
RUN apk add --no-cache ca-certificates curl \
    && curl -fsSL https://dl.min.io/server/minio/release/linux-amd64/minio \
       -o /usr/local/bin/minio \
    && chmod +x /usr/local/bin/minio
VOLUME /data
EXPOSE 9000 9001
ENTRYPOINT ["/usr/local/bin/minio"]
