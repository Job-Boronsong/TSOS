FROM node:24-alpine AS base
# Keep production installs reproducible. `pnpm@latest` can introduce new
# lockfile-verification behavior without a code change.
RUN corepack enable && corepack prepare pnpm@10.26.1 --activate
ENV npm_config_fetch_retries=5 \
    npm_config_fetch_retry_factor=2 \
    npm_config_fetch_retry_mintimeout=10000 \
    npm_config_fetch_retry_maxtimeout=120000 \
    npm_config_fetch_timeout=300000
WORKDIR /app

# ── Stage 1: Install all dependencies ───────────────────────────────────────
FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY lib/db/package.json             lib/db/
COPY lib/api-spec/package.json       lib/api-spec/
COPY lib/api-zod/package.json        lib/api-zod/
COPY lib/api-client-react/package.json lib/api-client-react/
COPY lib/object-storage-web/package.json lib/object-storage-web/
COPY artifacts/api-server/package.json artifacts/api-server/
RUN --mount=type=cache,id=tsos-pnpm-store,target=/root/.local/share/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile --ignore-scripts --network-concurrency=4

# ── Stage 2: Build (esbuild bundles everything into dist/index.mjs) ─────────
FROM deps AS builder
COPY tsconfig.base.json tsconfig.json ./
COPY lib/ lib/
COPY artifacts/api-server/ artifacts/api-server/
RUN pnpm --filter @workspace/api-server run build

# ── Stage 3: Lean production runner ─────────────────────────────────────────
# The esbuild bundle is self-contained, but external packages (nodemailer,
# @google-cloud/storage) must still exist in node_modules at runtime.
FROM node:24-alpine AS runner
RUN corepack enable && corepack prepare pnpm@10.26.1 --activate
ENV npm_config_fetch_retries=5 \
    npm_config_fetch_retry_factor=2 \
    npm_config_fetch_retry_mintimeout=10000 \
    npm_config_fetch_retry_maxtimeout=120000 \
    npm_config_fetch_timeout=300000
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY lib/db/package.json             lib/db/
COPY lib/api-spec/package.json       lib/api-spec/
COPY lib/api-zod/package.json        lib/api-zod/
COPY lib/api-client-react/package.json lib/api-client-react/
COPY lib/object-storage-web/package.json lib/object-storage-web/
COPY artifacts/api-server/package.json artifacts/api-server/
RUN --mount=type=cache,id=tsos-pnpm-store,target=/root/.local/share/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile --ignore-scripts --prod --network-concurrency=4
COPY --from=builder /app/artifacts/api-server/dist artifacts/api-server/dist

EXPOSE 8080
ENV PORT=8080
WORKDIR /app/artifacts/api-server
CMD ["node", "--enable-source-maps", "./dist/index.mjs"]
